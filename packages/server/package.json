{
  "name": "@ripen/server",
  "version": "0.3.0",
  "description": "Self-hosted Ripen server: Node.js built-ins and SQLite, no runtime dependencies.",
  "keywords": [
    "ripen",
    "feature-flags",
    "release-channels",
    "self-hosted",
    "sqlite"
  ],
  "homepage": "https://github.com/userTrv/ripen/tree/main/packages/server#readme",
  "bugs": {
    "url": "https://github.com/userTrv/ripen/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/userTrv/ripen.git",
    "directory": "packages/server"
  },
  "license": "Apache-2.0",
  "author": "Kirill Levin (https://usertrv.dev)",
  "type": "module",
  "exports": {
    ".": {
      "ripen-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./engine": {
      "ripen-source": "./src/engine.ts",
      "types": "./dist/engine.d.ts",
      "default": "./dist/engine.js"
    }
  },
  "files": [
    "README.md",
    "dist"
  ],
  "bin": {
    "ripen-server": "./dist/main.js"
  },
  "dependencies": {
    "@ripen/core": "workspace:*"
  },
  "devDependencies": {
    "@ripen/sdk": "workspace:*"
  },
  "engines": {
    "node": ">=22.13"
  },
  "publishConfig": {
    "access": "public"
  }
}

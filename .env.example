# Copy to ripen.env (or .env) and fill in. Never commit the filled file.
# Generate values with: openssl rand -hex 24

# Shipped inside your apps; only grants the client API.
RIPEN_CLIENT_KEY=
# Secret: release console, CLI and CI.
RIPEN_ADMIN_TOKEN=

# Optional
# RIPEN_CORS_ORIGINS=https://app.example.com
# RIPEN_CONFIG=/data/ripen.config.json
# RIPEN_DB=/data/ripen.db
# Delete events older than this many days (unset keeps everything)
# RIPEN_RETENTION_DAYS=180
# Send events (promotions, rollbacks, reports, demotions) to a webhook
# RIPEN_WEBHOOK_URL=https://hooks.example.com/ripen
# RIPEN_WEBHOOK_SECRET=
# RIPEN_WEBHOOK_EVENTS=feature.promoted,feature.rolled_back,report.created
